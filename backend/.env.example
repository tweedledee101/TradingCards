# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_cards
DB_USER=postgres
DB_PASSWORD=your_password_here

# eBay API Credentials
# Get these from: https://developer.ebay.com/
EBAY_APP_ID=your_app_id
EBAY_CERT_ID=your_cert_id
EBAY_DEV_ID=your_dev_id
EBAY_TOKEN=your_token

# Card Ladder API (if available)
CARD_LADDER_API_KEY=your_api_key

# Twitter API (for social signals)
TWITTER_BEARER_TOKEN=your_bearer_token

# Reddit API (for social signals)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
