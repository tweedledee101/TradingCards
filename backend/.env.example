# Optional: explicit dev DB URL. If unset, dev URL is derived from DATABASE_URL as …/trading_cards_dev (migrate.py --dev creates DB if needed).
# DATABASE_URL_DEV=postgresql://USER:PASS@RDS_HOST:5432/trading_cards_dev

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_cards
DB_USER=postgres
DB_PASSWORD=your_password_here

# Amazon Nova (optional)
# Chat-style scripts (OpenAI-compatible): https://api.nova.amazon.com/v1 — use NOVA_API_KEY
# Nova Act Python SDK (browser): expects NOVA_ACT_API_KEY — generate at https://nova.amazon.com/act
# Often the same key is used for both; if only one is set, nova_act_listing_visual_probe loads backend/.env and falls back NOVA_API_KEY → NOVA_ACT_API_KEY
# Multimodal / vision retry (scripts/vision_retry_scp_from_images.py): override if default model rejects images
# NOVA_VISION_MODEL=nova-2-lite-v1
# NOVA_API_KEY=
# NOVA_ACT_API_KEY=

# eBay API Credentials
# Get these from: https://developer.ebay.com/
EBAY_APP_ID=your_app_id
EBAY_CERT_ID=your_cert_id
EBAY_DEV_ID=your_dev_id
EBAY_TOKEN=your_token

# SportsCardsPro Selenium (auction/BIN pipeline SCP fallback); seconds, clamped 15–180
# SCP_PAGE_LOAD_TIMEOUT=60   # raise to 90–120 if Selenium "Navigation timed out" is noisy (local or Actions)

# Card Ladder API (if available)
CARD_LADDER_API_KEY=your_api_key

# Twitter API (for social signals)
TWITTER_BEARER_TOKEN=your_bearer_token

# Reddit API (for social signals)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret

# Cognito JWT (required for authenticated API routes)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
COGNITO_CLIENT_ID=your_app_client_id

# Optional: comma-separated browser origins (default includes localhost + ragnarokgamez.com)
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://ragnarokgamez.com
