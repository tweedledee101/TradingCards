# AWS Lambda container image — FastAPI + Mangum (no local Selenium)
FROM public.ecr.aws/lambda/python:3.11

COPY backend/requirements-lambda.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-lambda.txt

COPY backend ${LAMBDA_TASK_ROOT}/backend
COPY config ${LAMBDA_TASK_ROOT}/config
COPY lambda_entry.py ${LAMBDA_TASK_ROOT}/

# Root module avoids importing backend.* during Lambda Init (faster cold start for /health).
CMD ["lambda_entry.handler"]
